---
import { renderToString } from 'discord-preview/server';
import 'discord-preview/style.css';
import { names, propsFor } from '../../../shared/protocol.ts';

export const getStaticPaths = () => names.map((fixture) => ({ params: { fixture } }));
const html = renderToString(propsFor(Astro.params.fixture!));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>discord-preview: astro-static</title>
    <style>
      body { margin: 0; background: #111; }
      .wrap { width: 800px; }
    </style>
  </head>
  <body>
    <div id="preview" class="wrap"><discord-preview set:html={html} /></div>
  </body>
</html>
